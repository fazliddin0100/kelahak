# Copy this file to .env.production.local and replace every CHANGE_ME value.
POSTGRES_USER=mezon
POSTGRES_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_HEX_VALUE
POSTGRES_DB=mezon

APP_PORT=3001
# Required: local path for an on-prem/LAN NAS share or removable backup disk.
BACKUP_PATH=E:/MezonBackups

JWT_SECRET=CHANGE_ME_USE_A_RANDOM_SECRET
JWT_SECRET_REFRESH=CHANGE_ME_USE_A_DIFFERENT_RANDOM_SECRET
JWT_EXPIRES_IN=5h
JWT_REFRESH_DAY=30d
SUPERADMIN_JWT_EXPIRES_IN=12h
SUPERADMIN_BOOTSTRAP_KEY=CHANGE_ME
SECURITY_LOG_KEY=CHANGE_ME
WAF_SYNC_KEY=CHANGE_ME

# Not required for the local offline rate limiter. Keep empty unless configured.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
