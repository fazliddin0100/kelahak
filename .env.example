# Copy this file to .env.production.local and replace every CHANGE_ME value.
# Generate secrets with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
POSTGRES_USER=mezon
POSTGRES_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_HEX_VALUE
POSTGRES_DB=mezon

APP_PORT=3001
# The app port is published on this address only. Keep 127.0.0.1 and put Nginx (TLS) in front.
APP_BIND_ADDRESS=127.0.0.1
# Required: local path for an on-prem/LAN NAS share or removable backup disk.
BACKUP_PATH=E:/MezonBackups

# Both secrets must be different random values of at least 32 characters (the app refuses shorter ones in production).
JWT_SECRET=CHANGE_ME_USE_A_RANDOM_SECRET
JWT_SECRET_REFRESH=CHANGE_ME_USE_A_DIFFERENT_RANDOM_SECRET
JWT_EXPIRES_IN=5h
JWT_REFRESH_DAY=8h
SUPERADMIN_JWT_EXPIRES_IN=8h
# At least 16 characters. Required to create the single SuperAdmin at /superadmin/register.
# Later this key will be replaced by an ERI (qualified electronic signature) check.
SUPERADMIN_BOOTSTRAP_KEY=CHANGE_ME
# Optional extra gate for the first SuperAdmin registration: comma-separated client IPs allowed
# to create it. Leave empty to allow registration from anywhere (the bootstrap key is still required).
SUPERADMIN_SETUP_IPS=

# Optional. When empty, the internal middleware->API keys are derived from JWT_SECRET.
SECURITY_LOG_KEY=
WAF_SYNC_KEY=

# Number of trusted reverse proxies in front of the app (Nginx = 1). The client IP is taken from the
# X-Forwarded-For entry added by that proxy. Use 0 only when the app is reached directly (no proxy).
TRUSTED_PROXY_HOPS=1
# Public origin(s) of the site, comma separated (e.g. https://mezon.example.uz). Only needed when Nginx
# does not forward the original Host header; used by the CSRF origin check.
APP_ORIGIN=

# Optional antivirus (clamd). When CLAMAV_HOST is set every uploaded file is scanned and rejected on failure.
# ANTIVIRUS_REQUIRED=true refuses uploads when no scanner is configured.
CLAMAV_HOST=
CLAMAV_PORT=3310
ANTIVIRUS_REQUIRED=false

# Key rotation: comma-separated paths of previous app encryption key files (read-only, for old records).
APP_ENCRYPTION_PREVIOUS_KEY_FILES=

# Not required for the local offline rate limiter. Keep empty unless configured.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
