<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Mezon qurilma agenti: user kompyuterida Windows xizmati sifatida ishlaydi.
    Faqat 127.0.0.1 da tinglaydi; MAC manzil, tizim diskining seriya raqami va
    qurilma kaliti (TPM yoki Windows kalit ombori) bilan imzolangan javob beradi.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MezonAgent</AssemblyName>
    <RootNamespace>MezonAgent</RootNamespace>
    <Version>1.1.0</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

</Project>
