// PostgreSQL is the application's only database; Prisma manages its schema.
// IDs are stored as text in PostgreSQL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DbRole {
  admin
  superAdmin
  user
  commander
  deputyCommander
  departmentCommander
  departmentDeputy
}

enum NomeklaturaStatus {
  CREATED
  APPROVED
  ARCHIVED
}

enum SecurityEventType {
  visit
  login_failed
  login_success
  rate_limit
  suspicious
  waf_block
  ddos
  admin_action
}

// ─── Foydalanuvchi grafik ───────────────────────────────────────────────────

model User {
  id        String   @id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  personal           Personal?
  auth               Auth?
  job                Job?
  devices            UserDevice[]
  sessions           UserSession[]
  pendingUploads     PendingUpload[]
  certificates       UserCertificate[]
  eimzoPackage       EimzoKeyPackage?
  eimzoDevices       UserEimzoDevice[]
  documentSignatures DocumentSignature[]
  documentTemplates  DocumentTemplate[]
  printRequestsMade  PrintRequest[]      @relation("PrintRequester")
  printRequestsGot   PrintRequest[]      @relation("PrintAssignee")
  loginChallenges    LoginChallenge[]

  ownedDocuments     Document[]            @relation("DocumentOwner")
  forwardedDocuments Document[]            @relation("DocumentForwardedBy")
  allowedOnDocuments DocumentAllowedUser[]
  uploadedFiles      File[]
  ownedNomeklatura   Nomeklatura[]         @relation("NomeklaturaOwner")
  createdNomeklatura Nomeklatura[]         @relation("NomeklaturaCreator")

  @@map("users")
}

model Personal {
  id        String   @id
  userId    String   @unique
  name      String
  fName     String
  sName     String
  province  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("personals")
}

model Auth {
  id        String   @id
  userId    String   @unique
  login     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auths")
}

model Role {
  id          String   @id
  role        DbRole   @default(user)
  province    String
  permissions String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  jobs Job[]

  @@map("roles")
}

model Job {
  id           String   @id
  userId       String   @unique
  roleId       String
  position     String
  organ        String
  department   String
  militaryRank String
  isUserTrue   Boolean  @default(false)
  shahobchaId  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role       @relation(fields: [roleId], references: [id])
  shahobcha Shahobcha? @relation(fields: [shahobchaId], references: [id], onDelete: SetNull)

  @@index([roleId])
  @@index([department])
  @@index([shahobchaId])
  @@map("jobs")
}

/// Shahobcha — viloyatdagi tashkiliy bo'linma. Uning admini shu shahobchaning kotibiyati.
model Shahobcha {
  id        String   @id
  name      String
  province  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobs Job[]

  @@unique([province, name])
  @@index([province])
  @@map("shahobchalar")
}

/// Ro'yxatdan o'tgan kompyuter (Mezon agentidan olingan ma'lumot). Bitta kompyuterda bir nechta
/// user bo'lishi mumkin, shuning uchun MAC noyob emas.
model Device {
  id             String    @id
  mac            String
  /// Barcha jismoniy kartalar MAC lari (vergul bilan); agentsiz bo'lsa bo'sh
  macs           String    @default("")
  ip             String
  hostname       String?
  diskSerial     String    @default("")
  diskModel      String    @default("")
  /// Agent qurilma kaliti barmoq izi (SHA-256 hex)
  agentKeySha256 String    @default("")
  /// "agent" — Mezon agentidan olingan; "none" — agentsiz ro'yxatdan o'tgan
  source         String    @default("none")
  note           String?
  lastSeen       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  users UserDevice[]

  @@index([mac])
  @@map("devices")
}

model UserDevice {
  userId   String
  deviceId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@id([userId, deviceId])
  @@map("user_devices")
}

model UserSession {
  id             String    @id
  userId         String
  createdAt      DateTime  @default(now())
  lastActivityAt DateTime  @default(now())
  expiresAt      DateTime
  revokedAt      DateTime?

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  pendingUploads PendingUpload[]

  @@index([userId, revokedAt])
  @@index([revokedAt, lastActivityAt])
  @@map("user_sessions")
}

// ─── Hujjatlar (metadata + alohida content — katta hajm uchun) ───────────────

model Document {
  id        String   @id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  title        String?
  grif         String?
  position     String?
  militaryRank String?
  fullName     String?

  copyNumber String[] @default([])
  copyIndex  Int?
  copyTotal  Int?

  // Imzolovchi / yo‘naltirish snapshotlari (JSONB — tez o‘qish)
  approvers       Json  @default("[]")
  sender          Json?
  receiver        Json  @default("[]")
  author          Json?
  bosSigned       Json?
  forwardedSigner Json?
  forwardedTo     Json  @default("[]")
  ownerAcceptedBy Json?

  ownerId String
  owner   User   @relation("DocumentOwner", fields: [ownerId], references: [id])

  status String @default("yangi")

  sharedWithAdmin        Boolean   @default(false)
  sentToCommander        Boolean   @default(false)
  sentToCommanderAt      DateTime?
  submittedToKotibiyat   Boolean   @default(false)
  submittedToKotibiyatAt DateTime?
  createdByKotibiyat     Boolean   @default(false)

  nomenclatureId String?
  nomenclature   Nomeklatura? @relation(fields: [nomenclatureId], references: [id])

  registrationIndex Int?
  year              Int?
  ownerRegion       String?
  sourceRegion      String?

  parentId String?
  parent   Document?  @relation("DocumentParent", fields: [parentId], references: [id])
  children Document[] @relation("DocumentParent")

  isCopy Boolean @default(false)

  forwardedById    String?
  forwardedBy      User?     @relation("DocumentForwardedBy", fields: [forwardedById], references: [id])
  forwardedAt      DateTime?
  forwardedComment String?

  currentViewIndex Int        @default(0)
  replyToId        String?
  replyTo          Document?  @relation("DocumentReply", fields: [replyToId], references: [id])
  replies          Document[] @relation("DocumentReply")

  resolvedAt          DateTime?
  /// Hujjatni ro'yxatga olgan kotibiyat xodimi (chop etish so'rovlari unga boradi)
  registeredById      String?
  registeredAt        DateTime?
  /// Hujjatni boshqa xodimga topshirish: qabul qilguncha kutadi (qabul qilsa egasi o'zgaradi)
  pendingTransferToId String?
  pendingTransferAt   DateTime?
  pendingTransferNote String?
  /// Nusxa aynan shu korxona (shahobcha) kotibiyatiga yuborilgan; null — eski viloyat nusxasi
  targetShahobchaId   String?
  ownerAccepted       Boolean   @default(false)
  ownerAcceptedAt     DateTime?

  content       DocumentContent?
  allowedUsers  DocumentAllowedUser[]
  attachments   DocumentAttachment[]  @relation("DocAttachments")
  attachedTo    DocumentAttachment[]  @relation("DocAttachmentTarget")
  signatures    DocumentSignature[]
  printRequests PrintRequest[]
  events        DocumentEvent[]

  @@index([ownerId])
  @@index([pendingTransferToId])
  @@index([status])
  @@index([ownerRegion])
  @@index([ownerRegion, year])
  @@index([nomenclatureId])
  @@index([createdAt(sort: Desc)])
  @@index([forwardedById])
  @@index([parentId])
  @@index([year, ownerRegion, status])
  // Imzolovchi/qabul qiluvchi JSON maydonlari bo'yicha qidiruv (@>)
  @@index([approvers(ops: JsonbPathOps)], type: Gin, map: "documents_approvers_gin")
  @@index([receiver(ops: JsonbPathOps)], type: Gin, map: "documents_receiver_gin")
  @@index([forwardedTo(ops: JsonbPathOps)], type: Gin, map: "documents_forwardedTo_gin")
  @@index([author(ops: JsonbPathOps)], type: Gin, map: "documents_author_gin")
  @@index([sender(ops: JsonbPathOps)], type: Gin, map: "documents_sender_gin")
  @@map("documents")
}

/// Katta hujjat matni alohida jadvalda — metadata so‘rovlari yengil qoladi
model DocumentContent {
  documentId String   @id
  content    Json
  updatedAt  DateTime @updatedAt

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("document_contents")
}

model DocumentAllowedUser {
  documentId String
  userId     String

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([documentId, userId])
  @@index([userId])
  @@map("document_allowed_users")
}

model DocumentAttachment {
  documentId   String
  attachmentId String

  document   Document @relation("DocAttachments", fields: [documentId], references: [id], onDelete: Cascade)
  attachment Document @relation("DocAttachmentTarget", fields: [attachmentId], references: [id], onDelete: Cascade)

  @@id([documentId, attachmentId])
  @@map("document_attachments")
}

// ─── Nomeklatura ─────────────────────────────────────────────────────────────

model Bolim {
  id        String   @id
  province  String
  bolim     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  nomeklatura NomeklaturaBolim[]

  @@index([province])
  @@map("bolims")
}

model Bolinma {
  id        String   @id
  province  String
  bolinma   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  nomeklatura NomeklaturaBolinma[]

  @@index([province])
  @@map("bolinmas")
}

model Nomeklatura {
  id                String            @id
  registrationIndex String
  title             String
  grif              String
  saqlashMuddati    Json
  qonunTuri         String
  ownerId           String
  creatorId         String
  ownerRegion       String
  author            Json
  status            NomeklaturaStatus @default(CREATED)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  owner   User @relation("NomeklaturaOwner", fields: [ownerId], references: [id])
  creator User @relation("NomeklaturaCreator", fields: [creatorId], references: [id])

  bolimLinks   NomeklaturaBolim[]
  bolinmaLinks NomeklaturaBolinma[]
  documents    Document[]

  @@index([ownerRegion])
  @@index([ownerId])
  @@index([status])
  @@map("nomeklatura")
}

model NomeklaturaBolim {
  nomeklaturaId String
  bolimId       String

  nomeklatura Nomeklatura @relation(fields: [nomeklaturaId], references: [id], onDelete: Cascade)
  bolim       Bolim       @relation(fields: [bolimId], references: [id], onDelete: Cascade)

  @@id([nomeklaturaId, bolimId])
  @@map("nomeklatura_bolim")
}

model NomeklaturaBolinma {
  nomeklaturaId String
  bolinmaId     String

  nomeklatura Nomeklatura @relation(fields: [nomeklaturaId], references: [id], onDelete: Cascade)
  bolinma     Bolinma     @relation(fields: [bolinmaId], references: [id], onDelete: Cascade)

  @@id([nomeklaturaId, bolinmaId])
  @@map("nomeklatura_bolinma")
}

// ─── Fayllar ─────────────────────────────────────────────────────────────────

model File {
  id               String   @id
  nomi             String
  raqami           String
  maxfiylik        String
  sanasi           String
  ownerRegion      String
  userUploadId     String
  filePath         String?
  mimeType         String?
  encryptedContent Bytes?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  uploader      User           @relation(fields: [userUploadId], references: [id])
  pendingUpload PendingUpload?

  @@index([userUploadId])
  @@index([ownerRegion])
  @@map("files")
}

model PendingUpload {
  id          String   @id
  sessionId   String
  userId      String
  fileId      String   @unique
  storagePath String
  createdAt   DateTime @default(now())

  session UserSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  file    File        @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@index([userId])
  @@map("pending_uploads")
}

// ─── Ro‘yxatga olish ─────────────────────────────────────────────────────────

model Registration {
  id                String   @id
  registrationIndex Int
  year              Int
  ownerRegion       String
  documentId        String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([ownerRegion, year, documentId])
  @@index([ownerRegion, year])
  @@map("registrations")
}

model RegistrationCounter {
  id          String   @id
  ownerRegion String
  year        Int
  seq         Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([ownerRegion, year])
  @@map("registration_counters")
}

// ─── Xavfsizlik ──────────────────────────────────────────────────────────────

model SecurityLog {
  id         String            @id
  type       SecurityEventType
  ip         String
  path       String
  method     String            @default("GET")
  userAgent  String?
  loginHint  String?
  message    String?
  statusCode Int?
  createdAt  DateTime          @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([type, createdAt(sort: Desc)])
  @@index([ip, createdAt(sort: Desc)])
  @@map("security_logs")
}

model BlockedIp {
  id        String   @id
  ip        String   @unique
  reason    String   @default("")
  blockedBy String   @default("")
  source    String   @default("manual")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
  @@map("blocked_ips")
}

// ─── E-IMZO (ichki PKI) ─────────────────────────────────────────────────────

/// Userga biriktirilgan ochiq sertifikat. Yopiq kalit serverga hech qachon kelmaydi.
/// Bekor qilingan sertifikat o'chirilmaydi — eski imzolarni tekshirish uchun saqlanadi.
model UserCertificate {
  id             String    @id
  userId         String
  fingerprint256 String    @unique
  serialNumber   String
  subject        String
  issuer         String
  notBefore      DateTime
  notAfter       DateTime
  pem            String
  status         String    @default("active")
  revokedAt      DateTime?
  revokedReason  String?
  createdAt      DateTime  @default(now())

  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  signatures DocumentSignature[]

  @@index([userId, status])
  @@map("user_certificates")
}

/// Serverda tayyorlangan, superadmin bir marta yuklab oladigan E-IMZO paketi (.mzk + .crt).
/// .mzk kalit paroli bilan shifrlangan va ilova kaliti bilan qo'shimcha shifrlanadi.
/// Yuklab olingach yozuv o'chiriladi.
model EimzoKeyPackage {
  id            String   @id
  userId        String   @unique
  certificateId String
  login         String
  fullName      String
  shahobcha     String
  keyFile       Json
  createdById   String
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("eimzo_key_packages")
}

/// Kirishda E-IMZO bilan imzolanadigan bir martalik so'rov (2 daqiqa).
model LoginChallenge {
  id        String    @id
  userId    String
  nonce     String
  kind      String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("login_challenges")
}

/// Hujjatga qo'yilgan E-IMZO imzosi: hujjat mazmunining SHA-256 xeshi ustida ECDSA P-256.
/// Hujjat keyin o'zgarsa, joriy xesh imzolangan xeshga mos kelmaydi — bu ko'rinib turadi.
/// Userning E-IMZO ishlatadigan kompyuteri (Mezon agenti). Birinchi imzoda yoziladi,
/// keyingi imzolarda shu qurilma kaliti, disk seriyasi va MAC talab qilinadi.
model UserEimzoDevice {
  id                 String    @id
  userId             String
  /// Agentning qurilma kaliti (SPKI DER, base64) va uning SHA-256 (hex)
  publicKey          String
  publicKeySha256    String
  /// Birinchi aloqadagi jismoniy kartalar MAC lari (vergul bilan, alifbo tartibida)
  macs               String
  primaryMac         String
  diskSerial         String
  diskModel          String    @default("")
  diskSerialReliable Boolean   @default(true)
  hardwareKey        Boolean   @default(false)
  hostname           String    @default("")
  /// E-IMZO kaliti turgan fleshka seriyasi va kalit fayli (.mzk) SHA-256 — birinchi imzoda yoziladi
  usbSerial          String    @default("")
  usbSerialReliable  Boolean   @default(true)
  usbModel           String    @default("")
  keySha256          String    @default("")
  /// Birinchi aloqada ishlatilgan sertifikat
  certificateId      String?
  status             String    @default("active")
  createdAt          DateTime  @default(now())
  lastSeenAt         DateTime  @default(now())
  revokedAt          DateTime?
  revokedReason      String?

  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  signatures DocumentSignature[]

  @@index([userId, status])
  @@index([publicKeySha256])
  @@map("user_eimzo_devices")
}

model DocumentSignature {
  id              String   @id
  documentId      String
  userId          String
  certificateId   String
  fingerprint256  String
  contentHash     String
  signature       String
  /// Aynan imzolangan matn — imzoni istalgan vaqtda qayta tekshirish uchun
  signedMessage   String
  signedAt        DateTime @default(now())
  /// Imzo qo'yilgan kompyuter (Mezon agenti tasdig'i bo'lsa)
  deviceId        String?
  /// Agent imzolagan matn va imzo — kompyuterni keyin ham tekshirish uchun
  deviceMessage   String?
  deviceSignature String?

  document    Document         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  certificate UserCertificate  @relation(fields: [certificateId], references: [id])
  device      UserEimzoDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([documentId, signedAt])
  @@index([userId])
  @@map("document_signatures")
}

/// Userning shaxsiy hujjat namunalari: "Yangi hujjat" da kiritilgan tur va shakl.
/// Galereyada ko'rinadi, bosilganda shu nom va shakl bilan yangi hujjat yaratiladi.
model DocumentTemplate {
  id               String   @id
  ownerId          String
  title            String
  /// Takrorlanishni oldini olish uchun: trim + kichik harf
  titleKey         String
  /// Shifrlangan HTML (documentContentEncryption, kontekst: tpl_<id>)
  content          Json
  /// Namunani yaratgan hujjat — faqat shu hujjat saqlanganda namuna yangilanadi
  sourceDocumentId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([ownerId, titleKey])
  @@index([sourceDocumentId])
  @@map("document_templates")
}

/// Ro'yxatga olingan hujjatni chop etish (Word) uchun so'rov.
/// Hujjat egasi yuboradi, hujjatni ro'yxatga olgan kotibiyat xodimi ko'rib chiqadi.
model PrintRequest {
  id             String    @id
  documentId     String
  requesterId    String
  /// null — eski hujjat (ro'yxatga olgan xodim noma'lum): viloyat kotibiyati ko'radi
  assigneeId     String?
  region         String?
  reason         String
  /// pending | approved | rejected
  status         String    @default("pending")
  decisionNote   String?
  decidedById    String?
  decidedAt      DateTime?
  downloadCount  Int       @default(0)
  lastDownloadAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  document  Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  requester User     @relation("PrintRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  assignee  User?    @relation("PrintAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([assigneeId, status])
  @@index([region, status])
  @@index([documentId])
  @@index([requesterId])
  @@map("print_requests")
}

/// Hujjat tarixi (jurnal): kim, qachon, nima qildi — imzolash, qaytarish, rezolyutsiya,
/// tanishish, kotibiyatga yuborish, ro'yxatga olish, topshirish va qabul qilish.
model DocumentEvent {
  id           String   @id
  documentId   String
  actorId      String?
  actorName    String
  /// author_signed | returned | commander_signed | resolution | acknowledged | reforwarded |
  /// submitted_kotibiyat | registered | transfer_requested | transfer_accepted | transfer_cancelled | linked_workfile
  type         String
  note         String?
  targetUserId String?
  targetName   String?
  createdAt    DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, createdAt])
  @@map("document_events")
}
